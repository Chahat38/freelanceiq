# GEMINI_API_KEY: Required for Gemini AI API calls.
# Set this variable in Vercel Project Settings > Environment Variables
GEMINI_API_KEY=your_gemini_api_key_here

# APP_URL: The URL where this app is hosted (optional in Vercel)
APP_URL=https://your-app-domain.vercel.app

# OPTIONAL: Email reminders via Resend (serverless safe)
# If provided, enables automated task reminder emails
RESEND_API_KEY=
EMAIL_FROM=reminders@freelanceiq.ai
